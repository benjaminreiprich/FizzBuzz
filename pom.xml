<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.github.benjaminreiprich</groupId>
    <artifactId>fizzbuzz-api</artifactId>
    <version>1.0.1</version>
    <name>fizzbuzz-api</name>
    <description>FizzBuzz REST API</description>

    <url>https://github.com/benjaminreiprich/FizzBuzz</url>

    <scm>
        <connection>scm:git:https://github.com/benjaminreiprich/FizzBuzz.git</connection>
        <developerConnection>scm:git:git@github.com:benjaminreiprich/FizzBuzz.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/benjaminreiprich/FizzBuzz</url>
    </scm>

    <!-- Empty on purpose: otherwise these are inherited from Spring Boot's own parent POM. -->
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>

    <properties>
        <java.version>25</java.version>
        <spotless-maven-plugin.version>3.10.3</spotless-maven-plugin.version>
        <palantir-java-format.version>2.102.0</palantir-java-format.version>
        <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
        <jqwik.version>1.10.1</jqwik.version>
        <archunit.version>1.5.1</archunit.version>
        <springdoc-openapi.version>3.1.1</springdoc-openapi.version>
        <coverage.line.minimum>0.90</coverage.line.minimum>
        <!-- JVM options for the test JVM. Empty by default; JaCoCo adds its agent to it at build time (see Surefire
             below). Declaring it here avoids a build error when JaCoCo is skipped and adds nothing. -->
        <argLine/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-java-version</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Mockito as a Java agent, step 1 of 2: the "properties" goal creates one Maven property per dependency,
                 holding the path of its jar. We use org.mockito:mockito-core:jar in step 2 (Surefire, below). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Mockito as a Java agent, step 2 of 2. Why: by default Mockito attaches itself to the JVM while
                         tests run; recent JDKs warn about this and will eventually forbid it. Loading it at startup
                         with -javaagent is the documented fix.
                         - @{argLine}: what JaCoCo put in argLine for coverage. @{...} (not ${...}) is read when the
                           tests start, after JaCoCo has run; ${argLine} would be read too early and lose coverage.
                         - -javaagent:${org.mockito:mockito-core:jar}: the Mockito jar path from step 1.
                         - -Xshare:off: silences a JVM warning that loading an agent triggers. Test JVM only. -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- verify fails on unformatted code; run ./mvnw spotless:apply to fix it. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                        </palantirJavaFormat>
                    </java>
                    <formats>
                        <format>
                            <includes>
                                <include>*.md</include>
                                <include>docs/**/*.md</include>
                                <include>src/**/*.yml</include>
                                <include>.github/**/*.yml</include>
                            </includes>
                            <excludes>
                                <!-- Git-ignored local files must never break the build. -->
                                <exclude>NOTES.md</exclude>
                                <exclude>CLAUDE.md</exclude>
                            </excludes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </format>
                    </formats>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!-- The gate targets business logic. Framework wiring is exercised by
                                 Spring tests but its line ratio says little about correctness. -->
                            <includes>
                                <include>io/github/benjaminreiprich/fizzbuzz/domain/**</include>
                                <include>io/github/benjaminreiprich/fizzbuzz/application/**</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
